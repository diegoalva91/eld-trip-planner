DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-domain.vercel.app
CORS_ALLOWED_ORIGINS=https://eld-minus-tripe.vercel.app
CORS_ALLOW_ALL_ORIGINS=false

# OpenStreetMap Nominatim (free public geocoder; no API key required)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ELDTripPlanner/2.0
# Recommended: add your real contact email when you submit/deploy the app.
NOMINATIM_CONTACT_EMAIL=
NOMINATIM_MIN_INTERVAL_SECONDS=1.1
NOMINATIM_CACHE_SECONDS=2592000

# Free public OSRM demo routing service (no API key required)
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
